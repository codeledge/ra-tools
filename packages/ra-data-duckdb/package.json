{
  "name": "ra-data-duckdb",
  "version": "0.1.0",
  "description": "Simple react-admin dataprovider for DuckDB",
  "main": "./dist/client.js",
  "module": "./dist/client.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/client.ts src/handlers.ts --format esm,cjs --treeshake --external react-admin --external ra-core --external ra-ui-materialui --external @duckdb/node-api && tsup src/index.ts --dts-only --external react-admin --external ra-core --external ra-ui-materialui --external @duckdb/node-api",
    "dev": "pnpm build --watch",
    "lint": "eslint src --fix",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "prepublish": "pnpm build",
    "test": "jest"
  },
  "files": [
    "/dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/handlers.mjs",
      "require": "./dist/handlers.js"
    }
  },
  "keywords": [
    "duckdb",
    "rest",
    "marmelab",
    "react-admin",
    "dataprovider",
    "admin",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codeledge/ra-data-simple-prisma.git",
    "directory": "packages/ra-data-duckdb"
  },
  "author": "Orlando Groppo <orlando.groppo@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@duckdb/node-api": "*",
    "react-admin": ">=5.7.2"
  },
  "peerDependenciesMeta": {
    "@duckdb/node-api": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^1.13.5",
    "deverything": "^5.5.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@duckdb/node-api": "1.5.5-r.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "eslint-config-custom": "workspace:*",
    "jest": "^30.2.0",
    "react-admin": "^5.14.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
